# Conexión a PostgreSQL.
# En local podés usar tu usuario de PostgreSQL; en otra máquina, usuario y contraseña.
DATABASE_URL=postgresql+psycopg2://usuario:password@localhost:5432/foodstore_integrador

# Clave para firmar el JWT. Tiene que tener al menos 32 caracteres.
SECRET_KEY=cambiar-esta-clave-por-una-de-al-menos-32-caracteres

# Configuración del token.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend para CORS.
FRONTEND_ORIGIN=http://localhost:5173
